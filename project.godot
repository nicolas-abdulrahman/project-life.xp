; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="project-Life.xp"
run/main_scene="uid://drnxryx0u53sl"
config/features=PackedStringArray("4.6", "Mobile")

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/stretch/mode="canvas_items"

[editor_plugins]

enabled=PackedStringArray("res://addons/GDTerminal/plugin.cfg", "res://addons/asset_cleaner/addons/ImportCleaner/plugin.cfg", "res://addons/godot_vim/plugin.cfg", "res://addons/godot_xterm/plugin.cfg", "res://addons/net.yarvis.pixel_pen/plugin.cfg")

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="mobile"
